# 시연 페이지 + 관리 API 조회(GET만) + 시연 드라이버.
# ${DEMO_ADMIN_TOKEN}은 nginx 이미지가 시작할 때 환경변수로 치환한다. 이 값은 nginx 설정 안에만 있고
# 페이지·JS·응답에는 나가지 않는다.
server_tokens off;

upstream linkud_gateway {
    server gateway:8000;
}

upstream demo_driver {
    server driver:8100;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/demo;
    client_max_body_size 1k;

    # 보안 헤더는 서버 단위로만 둔다(위치별 add_header가 있으면 이 값들이 사라진다)
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;

    location / {
        limit_except GET {
            deny all;
        }
        try_files $uri $uri/index.html =404;
    }

    # 관리 API는 조회 세 경로만, GET만. 토큰은 여기서 붙인다
    location ~ ^/api/admin/(audit|verdicts|servers)$ {
        limit_except GET {
            deny all;
        }
        proxy_set_header Authorization "Bearer ${DEMO_ADMIN_TOKEN}";
        proxy_set_header Host gateway:8000;
        proxy_set_header Cookie "";
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_pass http://linkud_gateway/admin/$1$is_args$args;
    }

    location /api/ {
        return 404;
    }

    location /driver/ {
        limit_except GET POST {
            deny all;
        }
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_read_timeout 60s;
        proxy_pass http://demo_driver;
    }
}
