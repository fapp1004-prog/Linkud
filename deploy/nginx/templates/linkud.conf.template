# nginx 공식 이미지가 시작할 때 ${DOMAIN}만 치환한다(정의된 환경변수만 치환)
limit_req_zone $binary_remote_addr zone=mcp:10m rate=10r/s;
limit_req_status 429;

server {
    listen 80;
    server_name ${DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;

    client_max_body_size 1m;

    location = /mcp {
        limit_req zone=mcp burst=20 nodelay;
        proxy_pass http://gateway:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        # Streamable HTTP의 SSE 응답을 바로 흘려보낸다
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /healthz { proxy_pass http://gateway:8000; }

    # 관리 API (게이트웨이가 관리 토큰으로 따로 인증) · Slack 버튼 (서명 검증)
    location /admin {
        limit_req zone=mcp burst=10 nodelay;
        proxy_pass http://gateway:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    # 브레이크 글래스 사람 전용 페이지 (break_glass_enabled일 때만 게이트웨이가 응답)
    location = /override {
        limit_req zone=mcp burst=5 nodelay;
        client_max_body_size 8k;
        proxy_pass http://gateway:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location ^~ /override/ {
        limit_req zone=mcp burst=10 nodelay;
        proxy_pass http://gateway:8000;
        proxy_set_header Host $host;
    }
    location = /slack/actions {
        limit_req zone=mcp burst=10 nodelay;
        proxy_pass http://gateway:8000;
        proxy_set_header Host $host;
    }
    location / { return 404; }
}
