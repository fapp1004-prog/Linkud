# 이 파일의 설정을 프로젝트 루트 .env에 복사하세요. 실제 키는 여기에 적지 마세요.
OPENAI_API_KEY=
LINKUD_B_MODEL=gpt-5.4-mini-2026-03-17
LINKUD_B_EFFORT=low
LINKUD_B_TIMEOUT=8
LINKUD_B_MAX_OUTPUT_TOKENS=1200
# 실제 호출/예약액 합계에 적용하는 로컬 상한. 발표용 $5를 남기려고 기본 $35.
LINKUD_B_BUDGET_USD=35
# 단가 단위: USD / 백만 토큰. 2026-11-27 공식 모델 문서 확인값.
LINKUD_B_INPUT_PRICE=0.75
LINKUD_B_OUTPUT_PRICE=4.5
# 선택: LLM 캐시/예산 장부 경로. 같은 PC 팀 실행은 같은 경로를 사용하세요.
# LINKUD_B_CACHE=C:/path/to/Linkud/data/llm_cache.db
